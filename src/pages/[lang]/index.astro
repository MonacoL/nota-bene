---
// Home introduttiva: a chi si rivolge il sito, come si usa, che non si salva niente.
// Il Percorso sta nella pagina Capitoli (ticket "Home introduttiva con menu verso Capitoli e Letture").
import Base from '../../layouts/Base.astro';
import { LINGUE, testi, url, type Lingua } from '../../i18n';
import { capitoli } from '../../contenuti/capitoli';

export function getStaticPaths() {
  return LINGUE.map((lang) => ({ params: { lang } }));
}

const lingua = Astro.params.lang as Lingua;
const t = testi(lingua);
const [primo] = await capitoli(lingua);
const parti = [t.introHome.perChi, t.introHome.comeSiUsa, t.introHome.cosaNonFa];
---
<Base lingua={lingua}>
  <h1>{t.descrizioneSito}</h1>

  {parti.map((p) => (
    <section>
      <h2>{p.titolo}</h2>
      <p>{p.testo}</p>
    </section>
  ))}

  <p class="azioni">
    <a class="pulsante" href={url(lingua, `capitoli/${primo!.id}/`)}>{t.introHome.comincia}</a>
    <a class="pulsante secondario" href={url(lingua, 'capitoli/')}>{t.introHome.tuttiICapitoli}</a>
  </p>

  <section class="letture" aria-labelledby="titolo-letture">
    <h2 id="titolo-letture">{t.letture}</h2>
    <p>{t.ingressoLetture}</p>
    <p><a class="pulsante secondario" href={url(lingua, 'letture/')}>{t.vaiAlleLetture}</a></p>
  </section>
</Base>

<style>
  h1 { font-size: 1.45rem; }
  h2 { font-size: 1.1rem; margin: 1.1em 0 0.25em; }
  section p { margin: 0; }
  .azioni { display: flex; flex-wrap: wrap; gap: 12px; margin: 1.5em 0; }
  .letture { margin-top: 1.5em; padding: 4px 16px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .letture h2 { margin-top: 0.8em; }
  .letture p + p { margin-top: 0.8em; }
</style>
