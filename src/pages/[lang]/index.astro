---
import Base from '../../layouts/Base.astro';
import { LINGUE, testi, type Lingua } from '../../i18n';

export function getStaticPaths() {
  return LINGUE.map((lang) => ({ params: { lang } }));
}

const lingua = Astro.params.lang as Lingua;
const t = testi(lingua);
---
<Base lingua={lingua}>
  <h1>{t.percorso}</h1>
  <p class="muted">{t.percorsoInPreparazione}</p>
</Base>
