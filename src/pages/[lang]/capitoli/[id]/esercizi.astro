---
// Pagina provvisoria: gli Esercizi arrivano con il ticket "Pagina Esercizi con la prima Serie: «Nomina la nota»".
import Base from '../../../../layouts/Base.astro';
import { LINGUE, testi, url, type Lingua } from '../../../../i18n';
import { capitoli, type Capitolo } from '../../../../contenuti/capitoli';

export async function getStaticPaths() {
  const pagine = [];
  for (const lang of LINGUE) {
    for (const capitolo of await capitoli(lang)) pagine.push({ params: { lang, id: capitolo.id }, props: { capitolo } });
  }
  return pagine;
}

interface Props {
  capitolo: Capitolo;
}
const { capitolo } = Astro.props;
const lingua = Astro.params.lang as Lingua;
const t = testi(lingua);
const titolo = t.eserciziDi.replace('{titolo}', capitolo.titolo);
---
<Base lingua={lingua} titolo={titolo}>
  <h1>{titolo}</h1>
  <p class="muted">{t.eserciziInPreparazione}</p>
  <p><a href={url(lingua, `capitoli/${capitolo.id}/`)}>{t.tornaAlCapitolo}</a></p>
</Base>
