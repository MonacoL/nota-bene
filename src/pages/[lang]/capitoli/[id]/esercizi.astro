---
import Base from '../../../../layouts/Base.astro';
import Serie from '../../../../components/esercizi/Serie.svelte';
import { LINGUE, testi, url, type Lingua } from '../../../../i18n';
import { capitoli, vicini, type Capitolo } from '../../../../contenuti/capitoli';

export async function getStaticPaths() {
  const pagine = [];
  for (const lang of LINGUE) {
    const percorso = await capitoli(lang);
    for (const capitolo of percorso) {
      pagine.push({ params: { lang, id: capitolo.id }, props: { capitolo, successivo: vicini(percorso, capitolo.id).successivo } });
    }
  }
  return pagine;
}

interface Props {
  capitolo: Capitolo;
  successivo?: Capitolo;
}
const { capitolo, successivo } = Astro.props;
const lingua = Astro.params.lang as Lingua;
const t = testi(lingua);
const titolo = t.eserciziDi.replace('{titolo}', capitolo.titolo);
const successivoHref = successivo && url(lingua, `capitoli/${successivo.id}/`);
---
<Base lingua={lingua} titolo={titolo}>
  {/* Prima del primo disegno, così col dito la pagina non scatta quando arriva l'isola della Serie. */}
  {capitolo.esercizi.length > 0 && <script is:inline>document.documentElement.setAttribute('data-serie', '')</script>}
  <p class="indietro"><a href={url(lingua, `capitoli/${capitolo.id}/`)}>{t.tornaAlCapitolo}</a></p>
  <h1>{titolo}</h1>

  {capitolo.esercizi.length
    ? <Serie
        client:only="svelte"
        lingua={lingua}
        t={t.serie}
        dichiarazioni={capitolo.esercizi}
        successivo={successivoHref ? { href: successivoHref, etichetta: t.capitoloSuccessivo } : undefined}
        capitolo={{ href: url(lingua, `capitoli/${capitolo.id}/`), etichetta: t.tornaAlCapitolo.replace(/^←\s*/, '') }}
      />
    : <p class="muted">{t.eserciziInPreparazione}</p>}

  {/* Sotto la Serie e non in alto: a 320 px ogni riga sopra il pentagramma lo spinge sotto il tastierino. */}
  {successivoHref && (
    <nav class="seguito" aria-label={t.navCapitoli}>
      <a rel="next" href={successivoHref}>{t.capitoloSuccessivo}</a>
    </nav>
  )}
</Base>

<style is:global>
  /*
   * Col dito, durante la Serie (Serie.svelte mette data-serie su <html>): la pagina è alta quanto lo schermo
   * e non scorre. Restano l'intestazione del sito e la Serie; avviso, titolo, link e piè di pagina tornano nel riepilogo.
   */
  @media not ((hover: hover) and (pointer: fine)) {
    html[data-serie] body { height: 100dvh; min-height: 0; overflow: hidden; }
    html[data-serie] .costruzione,
    html[data-serie] .piede,
    html[data-serie] main > h1,
    html[data-serie] main > .indietro,
    html[data-serie] main > .seguito { display: none; }
    /* Su uno schermo troppo basso scorre la Serie, non la pagina: "Avanti →" non va mai perso. */
    html[data-serie] main { display: flex; flex-direction: column; min-height: 0; overflow-y: auto; padding-top: 4px; padding-bottom: 12px; }
  }
</style>

<style>
  .indietro { margin: 8px 0 0; }
  .indietro a, .seguito a { display: inline-flex; align-items: center; min-height: 48px; }
  h1 { margin-top: 0.2em; }
  .seguito { display: flex; justify-content: flex-end; margin-top: 1.5em; padding-top: 1em; border-top: 1px solid var(--line); }
</style>
