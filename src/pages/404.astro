---
// Un solo 404, bilingue (ticket "Navigazione e architettura delle pagine").
import '../styles/global.css';
import Segno from '../components/Segno.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pagina non trovata · Page not found · Nota Bene</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <main class="wrap">
      <p class="marchio"><Segno /><span>Nota Bene</span></p>
      <section>
        <h1>Pagina non trovata</h1>
        <p>L'indirizzo non corrisponde a nessuna pagina.</p>
        <p><a href={`${base}it/`}>Vai alla home in italiano</a></p>
      </section>
      <section lang="en">
        <h1>Page not found</h1>
        <p>This address does not match any page.</p>
        <p><a href={`${base}en/`}>Go to the English home page</a></p>
      </section>
    </main>
  </body>
</html>

<style>
  .marchio { display: flex; align-items: center; gap: 8px; margin: 24px 0 0; font-weight: 700; font-size: 1.2rem; }
  section + section { border-top: 1px solid var(--line); margin-top: 24px; }
</style>
