---
// L'etichetta del Percorso di un Capitolo (ADR-0011): un'icona e il nome, in minuscolo come vuole il glossario.
// Ritmico: due semiminime. Armonico: tre note impilate, un accordo. Melodico: tre note che salgono legate.
import type { NomePercorso } from '../../contenuti/schemi';
import { testi, type Lingua } from '../../i18n';

interface Props {
  lingua: Lingua;
  percorso: NomePercorso;
}
const { lingua, percorso } = Astro.props;
const t = testi(lingua);
---
<span class={`etichetta ${percorso}`}>
  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
    {percorso === 'ritmico' && (
      <g>
        <ellipse cx="4.5" cy="15" rx="3" ry="2.2" transform="rotate(-20 4.5 15)" />
        <rect x="6.6" y="3" width="1.4" height="12" />
        <ellipse cx="13.5" cy="15" rx="3" ry="2.2" transform="rotate(-20 13.5 15)" />
        <rect x="15.6" y="3" width="1.4" height="12" />
      </g>
    )}
    {percorso === 'armonico' && (
      <g>
        <ellipse cx="7" cy="17" rx="2.7" ry="1.9" transform="rotate(-20 7 17)" />
        <ellipse cx="7" cy="10.5" rx="2.7" ry="1.9" transform="rotate(-20 7 10.5)" />
        <ellipse cx="7" cy="4" rx="2.7" ry="1.9" transform="rotate(-20 7 4)" />
        <rect x="9.3" y="1" width="1.3" height="16" />
      </g>
    )}
    {percorso === 'melodico' && (
      <g>
        <ellipse cx="3.5" cy="16" rx="2.6" ry="2" transform="rotate(-20 3.5 16)" />
        <ellipse cx="10" cy="11" rx="2.6" ry="2" transform="rotate(-20 10 11)" />
        <ellipse cx="16.5" cy="6" rx="2.6" ry="2" transform="rotate(-20 16.5 6)" />
        <path d="M3.5 13 Q10 4 16.5 3" fill="none" stroke="currentColor" stroke-width="1.3" />
      </g>
    )}
  </svg>
  {t.percorsi[percorso]}
</span>

<style>
  .etichetta {
    display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px 2px 8px;
    border: 1px solid var(--line); border-radius: 20px;
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); white-space: nowrap;
  }
  svg { fill: var(--accent); color: var(--accent); flex: none; }
</style>
