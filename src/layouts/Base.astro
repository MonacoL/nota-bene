---
import '../styles/global.css';
import Segno from '../components/Segno.astro';
import Scritta from '../components/Scritta.astro';
import CambioLingua from '../components/CambioLingua.svelte';
import { IN_COSTRUZIONE } from '../config';
import { PAGINE_SERVIZIO } from '../contenuti/pagine';
import { testi, url, urlInAltraLingua, altraLingua, type Lingua } from '../i18n';

interface Props {
  lingua: Lingua;
  titolo?: string;
}
const { lingua, titolo } = Astro.props;
const t = testi(lingua);
const tAltra = testi(altraLingua(lingua));
const titoloPagina = titolo ? `${titolo} / ${t.nomeSito}` : t.nomeSito;
const base = import.meta.env.BASE_URL;
// Le voci del menu: link nell'intestazione da 440 px in su, pulsante con le lineette sotto (ticket "Home introduttiva con menu verso Capitoli e Letture").
const voci = [
  { href: url(lingua, 'capitoli/'), testo: t.navCapitoli },
  { href: url(lingua, 'letture/'), testo: t.letture },
];
---
<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    <meta name="description" content={t.descrizioneSito} />
    {IN_COSTRUZIONE && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang={altraLingua(lingua)} href={urlInAltraLingua(Astro.url.pathname, lingua)} />
  </head>
  <body>
    <a class="salta" href="#contenuto">{t.vaiAlContenuto}</a>
    {IN_COSTRUZIONE && <p class="costruzione" role="note">{t.inCostruzione}</p>}
    <header class="top">
      <div class="wrap">
        <a class="marchio" href={url(lingua)}><Segno /><Scritta /></a>
        <nav class="nav" aria-label={t.navPrincipale}>
          {voci.map((v) => <a href={v.href}>{v.testo}</a>)}
        </nav>
        <CambioLingua
          client:load
          lingua={lingua}
          href={urlInAltraLingua(Astro.url.pathname, lingua)}
          etichetta={t.cambiaLingua}
          nomeAltraLingua={tAltra.lingua}
        />
        <details class="menu">
          <summary aria-label={t.menu} title={t.menu}>
            <svg class="apri" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
            <svg class="chiudi" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
          </summary>
          <nav aria-label={t.navPrincipale}>
            {voci.map((v) => <a href={v.href}>{v.testo}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="contenuto" class="wrap">
      <slot />
    </main>
    <footer class="piede">
      <div class="wrap">
        <nav aria-label={t.piePagina.paginaServizio}>
          <ul>
            {PAGINE_SERVIZIO.map((p) => <li><a href={url(lingua, `${p}/`)}>{t.pagine[p]}</a></li>)}
          </ul>
        </nav>
        <p class="licenze">{t.piePagina.licenze}</p>
      </div>
    </footer>
    <script>
      // Il menu con le lineette si chiude con Esc o toccando fuori; senza JavaScript si apre e si chiude dal pulsante.
      const menu = document.querySelector<HTMLDetailsElement>('header .menu');
      if (menu) {
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
        document.addEventListener('click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
      }
    </script>
  </body>
</html>

<style>
  .costruzione {
    margin: 0; padding: 8px 16px; text-align: center; font-size: 0.9rem;
    background: var(--surface); color: var(--muted); border-bottom: 1px solid var(--line);
  }
  .top { border-bottom: 1px solid var(--line); }
  .top .wrap { display: flex; flex-wrap: wrap; align-items: center; column-gap: 8px; min-height: 56px; }
  .marchio {
    display: flex; align-items: center; gap: 8px; min-height: 48px;
    color: var(--ink); text-decoration: none;
  }
  .nav { margin-left: auto; }
  .nav a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 6px; font-weight: 700; }
  /* Marchio, link e lingua insieme chiedono circa 430 px: sotto i 440 i link passano nel pulsante con le lineette. */
  .menu { display: none; }
  @media (max-width: 439px) {
    .top .wrap { position: relative; }
    .marchio { gap: 6px; }
    .nav { display: none; }
    .top :global(.lingua) { margin-left: auto; }
    .menu { display: block; }
  }
  .menu summary {
    display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin-right: -12px;
    list-style: none; cursor: pointer; color: var(--ink); border-radius: var(--radius);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu svg { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .menu .chiudi, .menu[open] .apri { display: none; }
  .menu[open] .chiudi { display: block; }
  .menu nav {
    position: absolute; z-index: 10; top: 100%; left: 0; right: 0;
    background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: 0 6px 12px rgb(0 0 0 / 0.08);
  }
  .menu nav a {
    display: flex; align-items: center; min-height: 48px; padding: 0 16px;
    border-top: 1px solid var(--line); font-weight: 700; text-decoration: none;
  }
  .piede { border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); padding: 16px 0 24px; }
  .piede ul { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-wrap: wrap; gap: 0 16px; }
  .piede li a { display: inline-flex; align-items: center; min-height: 48px; }
  .licenze { margin: 0; }
</style>
