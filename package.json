{
  "name": "nota-bene",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:esempio": "NOTA_BENE_LETTURE=tests/e2e/letture-esempio astro build",
    "preview": "astro preview",
    "check": "astro check",
    "valida:letture": "tsx scripts/valida-letture.ts",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npm run build:esempio && scripts/playwright-docker.sh",
    "test:update": "npm run build && npm run build:esempio && scripts/playwright-docker.sh --update-snapshots=changed",
    "elenco-da-verificare": "tsx scripts/elenco-da-verificare.ts",
    "nuova-edizione": "tsx scripts/nuova-edizione.ts",
    "letture-toccate": "tsx scripts/letture-toccate.ts",
    "nuova-lettura": "tsx scripts/nuova-lettura.ts",
    "controlla:campioni": "tsx scripts/controlla-campioni.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/svelte": "9.1.2",
    "abcjs": "6.7.2",
    "astro": "7.4.7",
    "smplr": "1.1.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
